{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MOON-132/sc-cockpit/blob/main/docs/dashboard.schema.json",
  "title": "SC Cockpit dashboard",
  "description": "Eine Dashboard-Datei für SC Cockpit. Verbindlich ist zusätzlich docs/DASHBOARD.md. Der Server kürzt Texte beim Speichern über die API und verwirft unbekannte Felder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "pages"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,40}$",
      "description": "Gleich dem Dateinamen ohne .json. Nicht local oder state."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "ship": {
      "type": "string",
      "maxLength": 40
    },
    "manufacturer": {
      "type": "string",
      "maxLength": 24
    },
    "role": {
      "type": "string",
      "maxLength": 40
    },
    "icon": {
      "type": "string",
      "maxLength": 20
    },
    "background": {
      "type": "string",
      "description": "Optionales Hintergrundbild (URL, data:image/... oder preset:aegis/crusader/drake/starmap)."
    },
    "bg_opacity": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 1.0
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "groups"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 40 },
        "label": { "type": "string", "minLength": 1, "maxLength": 24 },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "buttons"],
      "properties": {
        "title": { "type": "string", "maxLength": 40 },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/button" }
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "keys"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 40 },
        "kind": { "enum": ["button", "shield", "power", "telemetry", "pair", "guard"] },
        "sc": { "type": "string", "maxLength": 60 },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "hint": { "type": "string", "maxLength": 60 },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "mode": { "enum": ["tap", "toggle", "hold"] },
        "color": { "enum": ["amber", "cyan", "red", "blue", "green", "slate"] },
        "wide": { "type": "boolean" },
        "span": { "type": "integer", "minimum": 1, "maximum": 4 },
        "danger": { "type": "boolean" }
      }
    }
  }
}
